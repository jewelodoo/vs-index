{%- comment -%}
  Jewel: البحث بالصورة (Visual search).
  Index is rebuilt daily by GitHub Actions (jewelodoo/vs-index, branch data).
  Model runs in the shopper's browser: the one the index manifest names (DINOv2-small via onnxruntime-web, or MediaPipe MobileNetV3).
{%- endcomment -%}
<style>
.jvs-btn{display:flex;align-items:center;justify-content:center;width:40px;height:40px;background:none;border:0;padding:0;color:currentColor;cursor:pointer}
.jvs-btn svg{width:23px;height:23px}
.jvs-in svg{width:20px;height:20px}
.jvs-ov{position:fixed;inset:0;z-index:2147483000;background:rgba(0,0,0,.45);display:none}
.jvs-ov.open{display:block}
html.jvs-lock,html.jvs-lock body{overflow:hidden!important}
.jvs-sh{position:absolute;inset:auto 0 0 0;max-height:92vh;max-height:88dvh;overflow:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;background:#fff;color:#111;border-radius:16px 16px 0 0;padding:16px 16px calc(16px + env(safe-area-inset-bottom));direction:rtl;font-family:var(--font-body-family);box-sizing:border-box}
@media (min-width:750px){.jvs-sh{inset:5vh auto auto 50%;transform:translateX(-50%);width:min(760px,94vw);border-radius:16px;max-height:90vh}}
@media (max-width:749px){.jvs-sh{bottom:var(--jvs-b,0px)!important}}.jvs-ov[style*="--jvs-b"] .jvs-sh{border-radius:16px}
.jvs-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.jvs-hd b{font-size:17px}
.jvs-x{background:none;border:0;font-size:26px;line-height:1;cursor:pointer;color:#111;width:44px;height:44px;padding:0}
.jvs-pick{display:flex;gap:10px;margin-bottom:4px}
.jvs-pick label{flex:1;text-align:center;border:1px dashed #aaa;border-radius:12px;padding:16px 4px;cursor:pointer;font-size:14px;white-space:nowrap;position:relative;overflow:hidden}
.jvs-pick input,.jvs-new input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;font-size:0}
.jvs-tip{font-size:13px;color:#666;margin:10px 0 0;text-align:center}
/* full screen: the photo on top, the results in a panel that slides up */
.jvs-full{position:fixed;inset:0;z-index:2147483001;background:#000;display:none;direction:rtl;font-family:var(--font-body-family);color:#111;overscroll-behavior:contain}
.jvs-full.open{display:block}
.jvs-top{position:absolute;top:0;left:0;right:0;z-index:3;display:flex;justify-content:space-between;align-items:center;padding:calc(6px + env(safe-area-inset-top)) 8px 0}
.jvs-top button,.jvs-new{width:44px;height:44px;border-radius:50%;border:0;background:rgba(0,0,0,.5);color:#fff;font-size:24px;line-height:1;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;position:relative;overflow:hidden}
.jvs-new svg{width:22px;height:22px}
.jvs-photo{position:absolute;left:0;right:0;top:0;height:var(--jvs-ph,58%);display:flex;align-items:center;justify-content:center;padding:calc(58px + env(safe-area-inset-top)) 10px 24px;box-sizing:border-box;transition:height .25s}
.jvs-stage{position:relative;touch-action:none;user-select:none;-webkit-user-select:none;max-width:100%;max-height:100%;line-height:0}
.jvs-stage canvas{display:block;max-width:100%;max-height:calc(var(--jvs-phpx,50vh) - 88px);width:auto;height:auto}
.jvs-sel{position:absolute;border:2px solid #fff;box-shadow:0 0 0 9999px rgba(0,0,0,.45);box-sizing:border-box;display:none}
.jvs-sel i{position:absolute;width:44px;height:44px}
.jvs-sel i:after{content:"";position:absolute;width:20px;height:20px;border:0 solid #fff}
.jvs-sel i.a{top:-22px;right:-22px}.jvs-sel i.a:after{top:16px;right:16px;border-top-width:5px;border-right-width:5px}
.jvs-sel i.b{top:-22px;left:-22px}.jvs-sel i.b:after{top:16px;left:16px;border-top-width:5px;border-left-width:5px}
.jvs-sel i.c{bottom:-22px;right:-22px}.jvs-sel i.c:after{bottom:16px;right:16px;border-bottom-width:5px;border-right-width:5px}
.jvs-sel i.d{bottom:-22px;left:-22px}.jvs-sel i.d:after{bottom:16px;left:16px;border-bottom-width:5px;border-left-width:5px}
.jvs-note{position:absolute;left:50%;top:calc(14px + env(safe-area-inset-top));transform:translateX(-50%);background:rgba(0,0,0,.6);color:#fff;border-radius:999px;padding:5px 14px;font-size:12px;white-space:nowrap;z-index:2}
.jvs-panel{position:absolute;left:0;right:0;bottom:0;top:var(--jvs-pt,calc(58% - 18px));background:#fff;border-radius:16px 16px 0 0;box-shadow:0 -6px 20px rgba(0,0,0,.25);display:flex;flex-direction:column;transition:top .25s;z-index:2}
.jvs-full.big .jvs-panel{top:calc(64px + env(safe-area-inset-top))}
.jvs-grab{flex:none;padding:8px 0 6px;display:flex;justify-content:center;cursor:grab;touch-action:none}
.jvs-grab span{display:block;width:44px;height:5px;border-radius:3px;background:#ccc}
.jvs-cats{flex:none;display:flex;gap:8px;overflow-x:auto;padding:0 12px 10px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.jvs-cats::-webkit-scrollbar{display:none}
.jvs-cats button{flex:none;border:1px solid #ddd;background:#fff;border-radius:999px;padding:7px 14px;font:inherit;font-size:13.5px;cursor:pointer;color:#111;white-space:nowrap;min-height:36px}
.jvs-cats button.on{background:#111;color:#fff;border-color:#111}
.jvs-cats button.guess{border-color:#111}
.jvs-list{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;padding:0 10px calc(16px + var(--jvs-b,0px) + env(safe-area-inset-bottom))}
.jvs-msg{text-align:center;font-size:14px;color:#444;margin:10px 0}
.jvs-res{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 8px}
.jvs-res a{color:inherit;text-decoration:none;font-size:12.5px;line-height:1.5}
.jvs-res img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:10px;background:#f2f2f2;display:block;margin-bottom:5px}
.jvs-res .t{height:3em;overflow:hidden}
.jvs-res .p{font-weight:700;font-size:15px;margin-top:2px}
.jvs-ai{display:none;width:100%;margin:16px 0 4px;background:#fff;color:#111;border:1.5px solid #111;border-radius:10px;padding:13px;font:inherit;font-size:14px;cursor:pointer}
.jvs-ai[disabled]{opacity:.5}
.jvs-res .x{position:relative}
.jvs-res .x:after{content:"نفس القطعة";position:absolute;top:6px;right:6px;background:#111;color:#fff;font-size:11px;padding:2px 8px;border-radius:20px}
.jvs-busy{position:absolute;inset:0;display:none;align-items:center;justify-content:center;pointer-events:none}
.jvs-busy.on{display:flex}
.jvs-busy span{display:block;width:34px;height:34px;border-radius:50%;border:3px solid rgba(255,255,255,.35);border-top-color:#fff;animation:jvsSpin .8s linear infinite}
@keyframes jvsSpin{to{transform:rotate(360deg)}}
@media (min-width:750px){
  .jvs-full{background:rgba(0,0,0,.55)}
  .jvs-photo{left:auto;right:calc(50% - 470px);width:420px;top:6vh;height:88vh!important;background:#000;border-radius:16px 0 0 16px;padding:60px 14px 40px}
  .jvs-stage canvas{max-height:calc(88vh - 110px)}
  .jvs-top{right:calc(50% - 470px);left:auto;width:420px;top:6vh;box-sizing:border-box}
  .jvs-panel,.jvs-full.big .jvs-panel{top:6vh!important;bottom:6vh;left:calc(50% - 470px);right:calc(50% - 50px);border-radius:0 16px 16px 0;box-shadow:none}
  .jvs-grab{visibility:hidden;padding:6px 0}
  .jvs-res{grid-template-columns:repeat(3,minmax(0,1fr))}
}
</style>
<script>
(function(){
  var BASE='https://cdn.jsdelivr.net/gh/jewelodoo/vs-index@data/';
  var MP='https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.2.3';
  var ORT='https://cdn.jsdelivr.net/npm/onnxruntime-web@1.20.1/dist/';
  var TOP=24, ov, st={};
  var CAM='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.7l1.3-2h7l1.3 2h1.7A2.5 2.5 0 0 1 21 8.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z"/><circle cx="12" cy="13" r="3.8"/></svg>';

  function addButton(){
    if(!window.matchMedia('(min-width:750px)').matches) return true;
    var right=document.querySelector('header.header .header__right');
    if(!right||right.querySelector('.jvs-btn')) return !!right;
    var b=document.createElement('button');
    b.type='button';b.className='jvs-btn header__icon';b.setAttribute('aria-label','ابحث بالصورة');b.innerHTML=CAM;
    b.addEventListener('click',open);
    var s=right.querySelector('search-modal');
    if(s&&s.nextSibling) right.insertBefore(b,s.nextSibling); else right.insertBefore(b,right.firstChild);
    return true;
  }
  function addFieldButtons(){
    document.querySelectorAll('form.search .field').forEach(function(f){
      if(f.querySelector('.jvs-in')) return;
      var b=document.createElement('button');
      b.type='button';b.className='search__button jvs-in focus-inset';b.setAttribute('aria-label','ابحث بالصورة');b.innerHTML=CAM;
      b.addEventListener('click',function(e){e.preventDefault();open();});
      var v=f.querySelector('voice-search-button');
      if(v&&v.nextSibling) f.insertBefore(b,v.nextSibling); else f.appendChild(b);
    });
  }

  function el(h){var d=document.createElement('div');d.innerHTML=h.trim();return d.firstChild;}
  var IMGICON='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M5 17l5-5 4 4 2-2 3 3"/></svg>';
  var fv; // the full-screen view
  function build(){
    // 1. small window: pick a photo
    ov=el('<div class="jvs-ov" role="dialog" aria-modal="true" aria-label="ابحث بالصورة"><div class="jvs-sh">'+
      '<div class="jvs-hd"><b>ابحث بالصورة</b><button class="jvs-x" aria-label="إغلاق">&times;</button></div>'+
      '<div class="jvs-pick"><label>📷 صوّر القطعة<input type="file" accept="image/*" capture="environment"></label><label>🖼️ اختر من الصور<input type="file" accept="image/*"></label></div>'+
      '<div class="jvs-tip">نلقى لك القطع اللي تشبهها في المتجر</div></div></div>');
    document.body.appendChild(ov);
    ov.addEventListener('click',function(e){if(e.target===ov) close();});
    ov.querySelector('.jvs-x').addEventListener('click',close);
    // 2. full screen: the photo with the box on top, the results in a panel below
    fv=el('<div class="jvs-full" role="dialog" aria-modal="true" aria-label="نتايج البحث بالصورة">'+
      '<div class="jvs-top"><button type="button" class="jvs-fx" aria-label="إغلاق">&times;</button><label class="jvs-new" aria-label="صورة ثانية">'+IMGICON+'<input type="file" accept="image/*"></label></div>'+
      '<div class="jvs-photo"><div class="jvs-stage"><canvas></canvas><div class="jvs-sel"><i class="a"></i><i class="b"></i><i class="c"></i><i class="d"></i></div><div class="jvs-busy"><span></span></div></div><div class="jvs-note">حرّكي المربع حول القطعة</div></div>'+
      '<div class="jvs-panel"><div class="jvs-grab" aria-hidden="true"><span></span></div><div class="jvs-cats"></div><div class="jvs-list"><div class="jvs-msg"></div><div class="jvs-res"></div>'+
      '<button type="button" class="jvs-ai">ما لقيتي القطعة؟ خلّي الذكاء يدقق 🔍</button></div></div></div>');
    document.body.appendChild(fv);
    fv.querySelector('.jvs-fx').addEventListener('click',close);
    fv.addEventListener('click',function(e){if(e.target===fv) close();}); // computer: click outside the window
    ov.querySelectorAll('.jvs-pick input').forEach(function(i){i.addEventListener('change',function(){if(i.files[0]) loadImage(i.files[0]); i.value='';});});
    var ni=fv.querySelector('.jvs-new input');ni.addEventListener('change',function(){if(ni.files[0]) loadImage(ni.files[0]); ni.value='';});
    fv.querySelector('.jvs-ai').addEventListener('click',second);
    setupCrop();setupPanel();
    st.cat='all';
    manifest().then(function(m){
      var c=fv.querySelector('.jvs-cats'),list=[{key:'all',label:'الكل'}].concat(m.cats);
      list.forEach(function(k){var b=document.createElement('button');b.type='button';b.textContent=k.label;b.dataset.k=k.key;if(k.key==='all')b.classList.add('on');
        b.addEventListener('click',function(){st.cat=k.key;c.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b)});if(st.img) search();});c.appendChild(b);});
    }).catch(function(){msg('البحث بالصورة غير متاح حالياً');});
  }
  function lock(on){document.documentElement.classList.toggle('jvs-lock',on);}
  function open(){ if(!ov) build(); ov.classList.add('open'); var pb=document.getElementById('PBarNextFrameWrapper'); if(pb&&!window.matchMedia('(min-width:750px)').matches) ov.style.setProperty('--jvs-b',pb.getBoundingClientRect().height+'px'); lock(true); warm(); }
  function close(){ ov.classList.remove('open'); if(fv) fv.classList.remove('open','big'); lock(false); }
  function msg(t){ fv.querySelector('.jvs-msg').textContent=t||''; }
  function busy(on){ fv.querySelector('.jvs-busy').classList.toggle('on',!!on); }
  // the results panel: swipe or tap the grip to open it over the photo, scroll down at its top to bring the photo back
  function setupPanel(){
    var g=fv.querySelector('.jvs-grab'),L=fv.querySelector('.jvs-list'),y0=null;
    g.addEventListener('pointerdown',function(e){y0=e.clientY;g.setPointerCapture(e.pointerId);});
    g.addEventListener('pointerup',function(e){if(y0===null)return;var dy=e.clientY-y0;y0=null;if(Math.abs(dy)<8) fv.classList.toggle('big'); else fv.classList.toggle('big',dy<0);});
    var ty=null;
    L.addEventListener('touchstart',function(e){ty=e.touches[0].clientY;},{passive:true});
    L.addEventListener('touchmove',function(e){if(ty===null)return;var dy=e.touches[0].clientY-ty;if(dy<-25&&!fv.classList.contains('big')){fv.classList.add('big');ty=null;}else if(dy>40&&L.scrollTop<=0&&fv.classList.contains('big')){fv.classList.remove('big');ty=null;}},{passive:true});
    L.addEventListener('wheel',function(e){if(e.deltaY>0&&!fv.classList.contains('big')) fv.classList.add('big');},{passive:true});
  }

  var _m;
  function manifest(){ return _m||(_m=fetch(BASE+'manifest.json?d='+new Date().toISOString().slice(0,10)).then(function(r){if(!r.ok) throw 0; return r.json();})); }
  var _e;
  // the model named in the index manifest: DINOv2 (ONNX, run with onnxruntime-web) or the older MediaPipe one.
  // Both give embed(canvas) -> Promise of an l2-normalised vector, made the same way as build_index.py.
  function embedder(){
    return _e||(_e=manifest().then(function(m){ return /dinov2/i.test(m.arch||'')?dino(m):mediapipe(m); }));
  }
  // DINOv2 runs in a background worker, so the page (and the box) keeps moving while the phone works; no worker: the page itself
  var WK="var ort,sess;onmessage=async function(e){var d=e.data;try{if(d.init){ort=await import(d.ORT+'ort.wasm.min.mjs');ort.env.wasm.wasmPaths=d.ORT;ort.env.wasm.numThreads=1;"+
    "sess=await ort.InferenceSession.create(d.model,{executionProviders:['wasm']});postMessage({id:d.id,ok:1});return;}"+
    "var f={};f[sess.inputNames[0]]=new ort.Tensor('float32',d.x,[d.N,3,d.S,d.S]);var o=await sess.run(f),t=o[sess.outputNames[0]],a=new Float32Array(t.data);"+
    "postMessage({id:d.id,data:a,dims:t.dims},[a.buffer]);}catch(err){postMessage({id:d.id,err:String(err)});}};";
  function worker(m){
    return new Promise(function(ok,no){
      var w;try{w=new Worker(URL.createObjectURL(new Blob([WK],{type:'text/javascript'})),{type:'module'});}catch(e){return no(e);}
      var n=0,wait={},t=setTimeout(function(){no(new Error('worker timeout'));},60000);
      w.onmessage=function(e){var f=wait[e.data.id];delete wait[e.data.id];if(f) f(e.data);};
      w.onerror=function(e){clearTimeout(t);no(e);};
      function call(msg,tr){return new Promise(function(r,j){msg.id=++n;wait[n]=function(d){d.err?j(new Error(d.err)):r(d);};w.postMessage(msg,tr||[]);});}
      call({init:1,ORT:ORT,model:m.model}).then(function(){clearTimeout(t);ok(function(x,N,S){return call({x:x,N:N,S:S},[x.buffer]);});},no);
    });
  }
  function dino(m){
    var S=m.size||224,MEAN=[0.485,0.456,0.406],STD=[0.229,0.224,0.225];
    function px(cv,x,o){var c=document.createElement('canvas');c.width=S;c.height=S;var g=c.getContext('2d');g.imageSmoothingEnabled=true;g.imageSmoothingQuality='high';g.drawImage(cv,0,0,S,S);var d=g.getImageData(0,0,S,S).data,n=S*S;for(var i=0;i<n;i++){for(var ch=0;ch<3;ch++) x[o+ch*n+i]=(d[i*4+ch]/255-MEAN[ch])/STD[ch];}}
    function out(data,dims,N){
      var T=dims[1],D=dims[2],res=[];
      for(var k=0;k<N;k++){var v=new Float32Array(data.subarray(k*T*D,k*T*D+D)),q=0;for(var i=0;i<D;i++) q+=v[i]*v[i];q=Math.sqrt(q)||1;for(i=0;i<D;i++) v[i]/=q;res.push(v);}
      res.tok={data:new Float32Array(data.subarray(D,T*D)),n:T-1,D:D};return res;
    }
    function make(run){
      function many(cvs){var N=cvs.length,L=3*S*S,x=new Float32Array(N*L);cvs.forEach(function(cv,k){px(cv,x,k*L);});return run(x,N,S).then(function(r){return out(r.data,r.dims,N);});}
      return {embedMany:many,embed:function(cv){return many([cv]).then(function(r){return r[0];});}};
    }
    var local=function(){
      return import(ORT+'ort.wasm.min.mjs').then(function(ort){
        ort.env.wasm.wasmPaths=ORT; ort.env.wasm.numThreads=1;
        return ort.InferenceSession.create(m.model,{executionProviders:['wasm']}).then(function(sess){
          return make(function(x,N,S){var f={};f[sess.inputNames[0]]=new ort.Tensor('float32',x,[N,3,S,S]);return sess.run(f).then(function(o){var t=o[sess.outputNames[0]];return {data:t.data,dims:t.dims};});});
        });
      });
    };
    return worker(m).then(make,function(e){console.warn('jvs worker',e);window.__jvsWorker=0;return local();}).then(function(E){if(window.__jvsWorker!==0)window.__jvsWorker=1;return E;});
  }
  function mediapipe(m){
    return import(MP+'/vision_bundle.mjs').then(function(V){
      return V.FilesetResolver.forVisionTasks(MP+'/wasm').then(function(fs){
        return V.ImageEmbedder.createFromOptions(fs,{baseOptions:{modelAssetPath:m.model},l2Normalize:true,runningMode:'IMAGE'});
      }).then(function(E){ return {embed:function(cv){ return Promise.resolve(E.embed(cv).embeddings[0].floatEmbedding); }}; });
    });
  }
  var _p;
  function pca(){ return _p||(_p=manifest().then(function(m){return fetch(BASE+'pca.bin?v='+m.version).then(function(r){return r.arrayBuffer();}).then(function(b){var f=new Float32Array(b);var D=f.length/(m.dim+1);return {mean:f.subarray(0,D),W:f.subarray(D),D:D,d:m.dim};});})); }
  var _c={};
  function cat(k){ return _c[k]||(_c[k]=manifest().then(function(m){return Promise.all([fetch(BASE+k+'.json?v='+m.version).then(function(r){return r.json();}),fetch(BASE+k+'.bin?v='+m.version).then(function(r){return r.arrayBuffer();})]).then(function(x){return {meta:x[0],vec:new Int8Array(x[1])};});})); }
  // the model is big (about 22 MB) and busy while it loads, so it starts only after a photo is picked, not when the window opens
  function warm(){ pca().catch(function(){}); }
  function seq(E,cvs){var V=[];return cvs.reduce(function(p,c){return p.then(function(){return E.embed(c).then(function(v){V.push(v);});});},Promise.resolve()).then(function(){return V;});}
  // one model run at a time (the early analysis and a search can overlap)
  var _q=Promise.resolve();
  function serial(fn){var p=_q.then(fn,fn);_q=p.catch(function(){});return p;}
  function embedAll(E,cvs){return serial(function(){return E.embedMany?E.embedMany(cvs).catch(function(){return seq(E,cvs);}):seq(E,cvs);});}
  // query = the same crops the index was built with (manifest.crops): the piece wins over the brand box
  function queryCrops(base,m){var CR=m.crops||[[1,.5,.5],[.75,.5,.5]],BW=base.width,BH=base.height;return CR.map(function(c){var cw=BW*c[0],ch=BH*c[0];return sub(base,(BW-cw)*c[1],(BH-ch)*c[2],cw,ch);});}
  // find the piece in the photo from the model's patch tokens (main direction of the patch features,
  // oriented so the centre is "piece"), keep the top 15% patches, box them with a 12% margin
  function autobox(tok){
    var n=tok.n,D=tok.D,g=Math.round(Math.sqrt(n)),P=new Float32Array(n*D),mu=new Float32Array(D),i,j,k;
    for(i=0;i<n;i++){var q=0;for(j=0;j<D;j++){q+=tok.data[i*D+j]*tok.data[i*D+j];}q=Math.sqrt(q)||1;for(j=0;j<D;j++){P[i*D+j]=tok.data[i*D+j]/q;mu[j]+=P[i*D+j]/n;}}
    for(i=0;i<n;i++) for(j=0;j<D;j++) P[i*D+j]-=mu[j];
    var u=new Float32Array(D),s=new Float32Array(n);for(j=0;j<D;j++) u[j]=Math.sin(j+1);
    for(k=0;k<25;k++){for(i=0;i<n;i++){var a=0;for(j=0;j<D;j++) a+=P[i*D+j]*u[j];s[i]=a;}var w=new Float32Array(D),z=0;for(i=0;i<n;i++) for(j=0;j<D;j++) w[j]+=P[i*D+j]*s[i];for(j=0;j<D;j++) z+=w[j]*w[j];z=Math.sqrt(z)||1;for(j=0;j<D;j++) u[j]=w[j]/z;}
    for(i=0;i<n;i++){var b=0;for(j=0;j<D;j++) b+=P[i*D+j]*u[j];s[i]=b;}
    var c=0,cn=0,e=0,en=0;for(i=0;i<n;i++){var y=Math.floor(i/g),x=i%g;if(x>=g/4&&x<3*g/4&&y>=g/4&&y<3*g/4){c+=s[i];cn++;}if(x===0||y===0||x===g-1||y===g-1){e+=s[i];en++;}}
    if(c/cn<e/en) for(i=0;i<n;i++) s[i]=-s[i];
    var cut=Array.from(s).sort(function(p,r){return r-p;})[Math.floor(n*0.15)];
    var x0=g,x1=-1,y0=g,y1=-1;for(i=0;i<n;i++){if(s[i]>=cut){var yy=Math.floor(i/g),xx=i%g;if(xx<x0)x0=xx;if(xx>x1)x1=xx;if(yy<y0)y0=yy;if(yy>y1)y1=yy;}}
    var X0=x0/g,X1=(x1+1)/g,Y0=y0/g,Y1=(y1+1)/g,mx=(X1-X0)*.12,my=(Y1-Y0)*.12;
    return {x:Math.max(0,X0-mx),y:Math.max(0,Y0-my),w:Math.min(1,X1+mx)-Math.max(0,X0-mx),h:Math.min(1,Y1+my)-Math.max(0,Y0-my)};
  }
  // whole photo: its crops + the crops of the piece found automatically (if the box is clearly smaller than the photo)
  function analyse(E,m,img,auto){
    return embedAll(E,queryCrops(img,m)).then(function(V){
      if(!auto||!V.tok) return V;
      if(st.sel) return V; // the shopper drew a box meanwhile: that box will be searched instead
      var r;try{r=autobox(V.tok);}catch(e){return V;}
      window.__jvsBox=r;
      if(!r||r.w*r.h>0.85||r.w<.1||r.h<.1) return V;
      if(img===st.img&&!st.sel){st.auto=r;drawSel();}
      var W=img.width,H=img.height,piece=sub(img,r.x*W,r.y*H,r.w*W,r.h*H);
      return embedAll(E,queryCrops(piece,m)).then(function(V2){return V.concat(V2);},function(){return V;});
    });
  }
  // start analysing the whole photo as soon as it is picked (the first search waits for it)
  function precompute(){var g=st.gen,img=st.img;st.pre=Promise.all([embedder(),manifest()]).then(function(a){if(g!==st.gen) throw new Error('stale');return analyse(a[0],a[1],img,true);});st.pre.catch(function(){});}

  function loadImage(file){
    var img=new Image(),url=URL.createObjectURL(file);
    img.onload=function(){
      var max=900,s=Math.min(1,max/Math.max(img.width,img.height));
      var cv=fv.querySelector('.jvs-stage canvas');cv.width=Math.round(img.width*s);cv.height=Math.round(img.height*s);
      cv.getContext('2d').drawImage(img,0,0,cv.width,cv.height);URL.revokeObjectURL(url);
      ov.classList.remove('open');fv.classList.add('open');fv.classList.remove('big');lock(true);
      var pb=document.getElementById('PBarNextFrameWrapper');if(pb) fv.style.setProperty('--jvs-b',pb.getBoundingClientRect().height+'px'); // theme preview bar (not for shoppers)
      var ph=fv.querySelector('.jvs-photo');fv.style.setProperty('--jvs-phpx',ph.getBoundingClientRect().height+'px');
      st.img=cv;st.sel=null;st.auto=null;st.ai=0;st.rank=null;drawSel();
      fv.querySelector('.jvs-res').innerHTML='';fv.querySelector('.jvs-ai').style.display='none';msg('جاري البحث…');busy(true);
      st.gen=(st.gen||0)+1;st.pre=null;
      setTimeout(function(){precompute();search();},50);
    };
    img.src=url;
  }
  // the box: drag a corner to resize it, drag inside to move it, drag outside it to draw a new one; letting go searches again
  function setupCrop(){
    var stage=fv.querySelector('.jvs-stage'),mode=null,start=null,orig=null;
    function pt(e){var r=st.img.getBoundingClientRect();return {x:Math.max(0,Math.min(1,(e.clientX-r.left)/r.width)),y:Math.max(0,Math.min(1,(e.clientY-r.top)/r.height))};}
    function cur(){return st.sel||st.auto||{x:0,y:0,w:1,h:1};}
    stage.addEventListener('pointerdown',function(e){
      if(!st.img)return; clearTimeout(st.dt); var t=e.target,p=pt(e),r=cur();
      mode=t.tagName==='I'?t.className:(p.x>r.x&&p.x<r.x+r.w&&p.y>r.y&&p.y<r.y+r.h?'move':'new');
      start=p;orig={x:r.x,y:r.y,w:r.w,h:r.h};stage.setPointerCapture(e.pointerId);e.preventDefault();
    });
    stage.addEventListener('pointermove',function(e){
      if(!mode)return; var p=pt(e),dx=p.x-start.x,dy=p.y-start.y,o=orig,x0=o.x,y0=o.y,x1=o.x+o.w,y1=o.y+o.h;
      if(mode==='new'){x0=Math.min(start.x,p.x);x1=Math.max(start.x,p.x);y0=Math.min(start.y,p.y);y1=Math.max(start.y,p.y);}
      else if(mode==='move'){var mx=Math.max(-o.x,Math.min(1-x1,dx)),my=Math.max(-o.y,Math.min(1-y1,dy));x0+=mx;x1+=mx;y0+=my;y1+=my;}
      else{ // corners in screen terms: a top-right, b top-left, c bottom-right, d bottom-left
        if(mode==='a'||mode==='c') x1=Math.min(1,Math.max(x0+.06,x1+dx)); else x0=Math.max(0,Math.min(x1-.06,x0+dx));
        if(mode==='a'||mode==='b') y0=Math.max(0,Math.min(y1-.06,y0+dy)); else y1=Math.min(1,Math.max(y0+.06,y1+dy));
      }
      st.sel={x:x0,y:y0,w:x1-x0,h:y1-y0};drawSel();
    });
    function end(){ if(!mode)return; mode=null; if(st.sel&&(st.sel.w<.06||st.sel.h<.06)){st.sel=null;} drawSel(); clearTimeout(st.dt); if(st.sel) st.dt=setTimeout(search,700); }
    stage.addEventListener('pointerup',end);stage.addEventListener('pointercancel',end);
  }
  function drawSel(){
    var s=fv.querySelector('.jvs-sel'),r=st.sel||st.auto;
    if(!st.img){s.style.display='none';return;}
    r=r||{x:0,y:0,w:1,h:1};
    s.style.display='block';s.style.left=(r.x*100)+'%';s.style.top=(r.y*100)+'%';s.style.width=(r.w*100)+'%';s.style.height=(r.h*100)+'%';
  }
  function sub(cv,x,y,w,h){var c=document.createElement('canvas');c.width=Math.max(1,Math.round(w));c.height=Math.max(1,Math.round(h));c.getContext('2d').drawImage(cv,x,y,w,h,0,0,c.width,c.height);return c;}

  var _a;
  function allIdx(){ return _a||(_a=manifest().then(function(m){ if(!m.all) return null; return Promise.all([fetch(BASE+'all.json?v='+m.version).then(function(r){return r.json();}),fetch(BASE+'all.bin?v='+m.version).then(function(r){return r.arrayBuffer();})]).then(function(x){return {cats:x[0].cats,vec:new Int8Array(x[1])};}); }).catch(function(){_a=null;return null;})); }
  function project(V,P){var d=P.d,D=P.D;return V.map(function(v){var o=new Float32Array(d),n=0;for(var j=0;j<d;j++){var s=0;for(var i=0;i<D;i++) s+=(v[i]-P.mean[i])*P.W[i*d+j];o[j]=s;n+=s*s;}n=Math.sqrt(n)||1;for(j=0;j<d;j++) o[j]/=n;return o;});}
  // best score per product of one category (max over the query crops and the product's photo crops)
  function rankCat(Q,C,d){ // in slices, so a touch on the box is not kept waiting
    var vec=C.vec,cnt=C.meta.counts,hs=C.meta.handles,out=[],k=0,p=0;
    return new Promise(function(done){(function step(){
      var end=Math.min(hs.length,p+300);
      for(;p<end;p++){var b=-9;for(var t=0;t<cnt[p];t++,k++){var off=k*d;for(var q=0;q<Q.length;q++){var s=0,qq=Q[q];for(var j=0;j<d;j++) s+=vec[off+j]*qq[j];if(s>b)b=s;}}out.push({h:hs[p],s:b});}
      if(p<hs.length) setTimeout(step,0); else done(out);
    })();});
  }
  // «الكل»: which category is the photo? the 40 closest products (one vector each, all.bin) vote; a close second is searched too
  function guess(Q,A,m,d){
    var n=A.cats.length,sc=new Float32Array(n);
    for(var p=0;p<n;p++){var off=p*d,b=-9;for(var q=0;q<Q.length;q++){var s=0,qq=Q[q];for(var j=0;j<d;j++) s+=A.vec[off+j]*qq[j];if(s>b)b=s;}sc[p]=b;}
    var top=Array.from(sc.keys()).sort(function(x,y){return sc[y]-sc[x];}).slice(0,40),v={};
    top.forEach(function(p,r){var c=A.cats[p];v[c]=(v[c]||0)+1/(r+5);});
    var ks=Object.keys(v).sort(function(x,y){return v[y]-v[x];}),out=[m.cats[ks[0]].key];
    if(ks[1]&&v[ks[1]]>=.6*v[ks[0]]) out.push(m.cats[ks[1]].key);
    return out;
  }
  function markGuess(keys){fv.querySelectorAll('.jvs-cats button').forEach(function(b){b.classList.toggle('guess',keys.indexOf(b.dataset.k)>-1);});}
  function search(){
    if(!st.img) return;
    var tok=st.sq=(st.sq||0)+1,stale=function(){return tok!==st.sq;};
    msg('جاري البحث…');busy(true);fv.querySelector('.jvs-ai').style.display='none';st.ai=st.ai||0;
    var cv=st.img,W=cv.width,H=cv.height,r=st.sel||{x:0,y:0,w:1,h:1};
    var base=sub(cv,r.x*W,r.y*H,r.w*W,r.h*H);st.q=base;
    var early=!st.sel&&st.pre;
    Promise.all([embedder(),pca(),manifest()]).then(function(a){
      var fresh=function(){return analyse(a[0],a[2],base,!st.sel);};
      return (early?early.catch(fresh):fresh()).then(function(V){return {Q:project(V,a[1]),d:a[1].d,m:a[2]};});
    }).then(function(x){
      if(stale()) return null;
      var keys=st.cat!=='all'?Promise.resolve([st.cat]):allIdx().then(function(A){
        return A?guess(x.Q,A,x.m,x.d):x.m.cats.map(function(c){return c.key;}); // no all.bin yet: every category
      });
      return keys.then(function(ks){
        if(st.cat==='all') markGuess(ks); else markGuess([]);
        return Promise.all(ks.map(cat)).then(function(Cs){
          return Cs.reduce(function(pr,C){return pr.then(function(all){if(stale()) return all;return rankCat(x.Q,C,x.d).then(function(r){return all.concat(r);});});},Promise.resolve([]));
        }).then(function(all){
          all.sort(function(p,q){return q.s-p.s;});
          var seen={};st.rank=all.filter(function(o){if(seen[o.h])return false;seen[o.h]=1;return true;}).map(function(o){return o.h;});
          if(stale()) return null;
          return show(st.rank.slice(0,TOP),null);
        });
      });
    }).then(function(n){ if(stale()) return; busy(false); if(n&&AI&&!st.ai) fv.querySelector('.jvs-ai').style.display='block'; })
    .catch(function(e){console.error(e);if(!stale()){busy(false);msg('صار خطأ، حاول مرة ثانية');}});
  }
  var PC={}; // product details already fetched (the store limits repeated requests)
  function show(list,exact){
    return Promise.all(list.map(function(h){return PC[h]||(PC[h]=fetch('/products/'+h+'.js').then(function(r){if(!r.ok){delete PC[h];return null;}return r.json();}).catch(function(){delete PC[h];return null;}));})).then(function(ps){
      var box=fv.querySelector('.jvs-res'),html='';
      ps.forEach(function(p,i){
        if(!p) return;
        var img=p.featured_image?(p.featured_image+(p.featured_image.indexOf('?')>-1?'&':'?')+'width=360'):'';
        html+='<a href="'+p.url+'"'+(exact&&list[i]===exact?' class="x"':'')+'><img loading="lazy" src="'+img+'" alt=""><div class="t">'+p.title.replace(/</g,'&lt;')+'</div><div class="p"><span class="money">SAR '+(p.price/100).toFixed(2)+'</span></div></a>';
      });
      box.innerHTML=html;msg(html?'':'ما لقينا نتائج، جرّب صورة أوضح أو قسم ثاني');
      fv.querySelector('.jvs-list').scrollTop=0;
      return html.length;
    });
  }
  // Second look (jewel-app, vsrerank.js). One press per photo.
  var AI='https://jewel-app-ic3o.onrender.com/vs/rerank';
  function second(){
    if(!st.q||!st.rank||st.ai) return; st.ai=1;
    var bt=fv.querySelector('.jvs-ai'),q=st.q,s=Math.min(1,768/Math.max(q.width,q.height)),c=document.createElement('canvas');
    c.width=Math.round(q.width*s);c.height=Math.round(q.height*s);c.getContext('2d').drawImage(q,0,0,c.width,c.height);
    bt.disabled=true;bt.style.display='none';msg('الذكاء يقارن القطعة بأقرب المنتجات… لحظات');busy(true);
    fetch(AI,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({img:c.toDataURL('image/jpeg',.85),ids:st.rank})})
      .then(function(r){return r.json();})
      .then(function(j){ if(!j.ok) throw new Error(j.error); window.__jvsAi=j.info; return show(j.ids.slice(0,TOP),j.exact); })
      .catch(function(e){console.error(e);msg('ما قدرنا ندقق الحين، النتايج اللي فوق هي الأقرب');})
      .then(function(){bt.disabled=false;busy(false);});
  }

  function init(){ var n=0;(function t(){ addFieldButtons(); if(!addButton()&&n++<40) setTimeout(t,250); })(); var pend=0;new MutationObserver(function(){if(pend)return;pend=1;requestAnimationFrame(function(){pend=0;addFieldButtons();});}).observe(document.body,{childList:true,subtree:true}); }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init); else init();
})();
</script>
